# образ с питоном, java ниже нужна спарку
FROM python:3.10-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless curl procps \
    && ln -s "$(dirname $(dirname $(readlink -f /usr/bin/java)))" /opt/java \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/opt/java
ENV SPARK_HOME=/usr/local/lib/python3.10/site-packages/pyspark
ENV PATH=$SPARK_HOME/bin:$PATH
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# сначала зависимости, чтобы правки дагов сами по себе не заставляли заново ставить библиотеки
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
#JDBC-драйвер postgres лежит отдельно, путь к нему передаем SparkSubmit из ямла
RUN mkdir -p /opt/spark/jars \
    && curl -fL --retry 3 https://jdbc.postgresql.org/download/postgresql-42.7.0.jar \
       -o /opt/spark/jars/postgresql-42.7.0.jar

ENV AIRFLOW_HOME=/usr/local/airflow
ENV AIRFLOW__CORE__EXECUTOR=LocalExecutor
ENV AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
ENV AIRFLOW__CORE__LOAD_EXAMPLES=False
ENV AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
WORKDIR /usr/local/airflow
RUN mkdir -p dags data logs
COPY ./dags/ ./dags/
COPY ./data/ ./data/
COPY bootstrap_airflow.py ./bootstrap_airflow.py

COPY tests/ ./tests/
